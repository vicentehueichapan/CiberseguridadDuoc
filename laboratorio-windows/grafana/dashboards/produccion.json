{
  "uid": "ev3-produccion",
  "title": "Sistema Alumnos - Producción (seguridad)",
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    { "id": 1, "type": "stat", "title": "Disponibilidad (up)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ev3" },
      "targets": [ { "refId": "A", "expr": "up{job=~\"produccion|staging\"}", "legendFormat": "{{job}}" } ] },
    { "id": 2, "type": "table", "title": "Versión desplegada (trazabilidad)",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ev3" },
      "targets": [ { "refId": "A", "expr": "app_info", "format": "table", "instant": true } ] },
    { "id": 3, "type": "timeseries", "title": "Logins fallidos por minuto (producción)",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ev3" },
      "targets": [ { "refId": "A", "expr": "sum(increase(login_fallidos_total{job=\"produccion\"}[1m]))", "legendFormat": "logins fallidos/min" } ] },
    { "id": 4, "type": "timeseries", "title": "Peticiones sospechosas por tipo (producción)",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ev3" },
      "targets": [ { "refId": "A", "expr": "sum by (tipo) (increase(peticiones_sospechosas_total{job=\"produccion\"}[1m]))", "legendFormat": "{{tipo}}" } ] },
    { "id": 5, "type": "timeseries", "title": "Respuestas HTTP por código (producción)",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ev3" },
      "targets": [ { "refId": "A", "expr": "sum by (status) (rate(http_requests_total{job=\"produccion\"}[1m]))", "legendFormat": "HTTP {{status}}" } ] },
    { "id": 6, "type": "timeseries", "title": "Latencia p95 por endpoint (producción)",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ev3" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket{job=\"produccion\"}[5m])))", "legendFormat": "{{endpoint}}" } ] }
  ]
}
